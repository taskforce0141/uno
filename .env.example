# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (optional overrides if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Set to "true" when deploying exclusively with Firebase Cloud Functions
VITE_USE_CLOUD_FUNCTIONS="false"

# Optional external multiplayer backend URL (for static Vercel deployments connecting to a separate Express/WebSocket host)
VITE_API_BASE_URL=""

# Optional server-side session secret for local Express guest fallback tokens
SESSION_SECRET=""

# Firebase Admin SDK (SERVER-SIDE ONLY - set in Vercel Project Settings -> Environment Variables)
# NEVER prefix these with VITE_ or expose them to frontend client code.
# Server Firestore connects to the "(default)" database ID automatically.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
